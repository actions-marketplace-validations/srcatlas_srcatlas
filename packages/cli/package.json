{
  "name": "srcatlas",
  "version": "0.0.1",
  "description": "Architecture maps for TypeScript repositories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srcatlas/srcatlas.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "srcatlas": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jiti": "2.7.0",
    "picomatch": "4.0.7",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@srcatlas/analyzer": "workspace:*",
    "@srcatlas/core": "workspace:*"
  }
}
